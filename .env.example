# Copy to .env.local (never commit). All secrets stay outside the repository (NFR-001).

# PostgreSQL. `pnpm db:local` prints a URL for the embedded local cluster.
DATABASE_URL=postgres://liferoute:liferoute@127.0.0.1:5432/liferoute_dev

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin the owner uses (LAN or Tailscale HTTPS). Used for cookies, CSRF origin checks and OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Optional extra trusted origins, comma separated (e.g. https://mac.tailnet-xyz.ts.net)
LIFEROUTE_TRUSTED_ORIGINS=

# Storage outside the repository for attachments and backups.
LIFEROUTE_DATA_DIR=~/LifeRouteData
# Backup encryption key (32 bytes, base64). Generate with: openssl rand -base64 32. Keep a copy offline.
LIFEROUTE_BACKUP_KEY=

# Google Calendar (optional). Stays "disconnected" until set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Toss read-only balance API (optional). Stays "disconnected" until set.
TOSS_API_KEY=
TOSS_API_SECRET=

# AI analysis (optional). No AI call is ever made without explicit per-run consent and budget check.
ANTHROPIC_API_KEY=
# Default model; the owner may pick a cheaper one (e.g. claude-haiku-4-5) to stretch the 3,000 KRW monthly AI budget.
LIFEROUTE_AI_MODEL=claude-opus-5
# KRW per USD used for AI cost previews and the monthly ledger.
LIFEROUTE_USD_KRW=1400
